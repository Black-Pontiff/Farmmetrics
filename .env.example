# Copy to .env and set production values as needed.
FARM_DB_PATH=farm_metrics.db
FARM_SIGNING_KEY_PATH=
FARM_HMAC_SECRET=dev-only-change-me-before-production
FARM_API_KEYS=
FARM_REQUIRE_DEVICE_SIGNATURES=0
FARM_LLM_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
FARM_LLM_TIMEOUT_S=5
FARM_LLM_MAX_TOKENS=200
FARM_API_BASE_URL=http://localhost:8000
FARM_SERIAL_PORT=/dev/ttyUSB0
FARM_SERIAL_BAUD=115200
FARM_GPIO_PUMP_PIN=17
FARM_SOIL_PUMP_THRESHOLD_PCT=30
